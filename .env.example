# Database (Neon Postgres: Dashboard -> Connect)
# Pooled connection (host contains "-pooler") for the app at runtime
DATABASE_URL="postgresql://user:password@ep-your-endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct (unpooled) connection for `npm run db:push`
DIRECT_URL="postgresql://user:password@ep-your-endpoint.region.aws.neon.tech/neondb?sslmode=require"

# File Storage (Cloudflare R2: R2 -> Overview for the account ID, R2 -> Manage API tokens for the keys)
# Create a PRIVATE bucket (leave "Public access" off). Then open the bucket -> Settings -> CORS Policy and add this,
# with your real site address (add http://localhost:3000 too while developing). Without it, browser uploads are blocked:
#   [{ "AllowedOrigins": ["https://your-domain.edu.ng"], "AllowedMethods": ["PUT"], "AllowedHeaders": ["content-type"], "MaxAgeSeconds": 3600 }]
R2_ACCOUNT_ID="your_cloudflare_account_id"
# Server-only; never expose to the browser. Use an API token with "Object Read & Write" on this bucket.
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET="course-uploads"

# Session Security (Required for cryptographic cookie signing)
# Generate a strong 32+ character random secret (e.g. `openssl rand -hex 32`)
SESSION_SECRET="your_production_hmac_session_secret_min_32_chars"

# Public support email shown on the contact dialog (optional: the card is hidden when unset)
NEXT_PUBLIC_SUPPORT_EMAIL="support@your-domain.edu.ng"

# Footer attribution line. Defaults to "A product of The Federal Polytechnic, Ado-Ekiti".
# Set your own text to change it, or "-" to hide it.
# NEXT_PUBLIC_INSTITUTION_NAME="A product of Your Institution"

# Public Application Base URL
NEXT_PUBLIC_APP_URL="https://your-domain.edu.ng"

# Sign in with Google (optional; the button stays hidden until this is set)
# Create at https://console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web application),
# then add your site address under "Authorized JavaScript origins" (https://your-domain and http://localhost:3000)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"

# Shared Rate Limiting (Upstash Redis REST) - required for accurate limits on serverless/multi-instance hosting
# Obtain from https://console.upstash.com -> Redis database -> REST API. Without these, limits are per-instance only.
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token"

# Checkout fees (all optional; with none of these set the student pays exactly the course price)
# Flat platform fee in Naira added to every paid course, e.g. 400
# PLATFORM_FEE_NGN="400"
# Set to "true" so the student also pays Paystack's processing fee and you receive the full course price + your fee
# PASS_PAYSTACK_FEE="true"
# Wording shown next to your fee at checkout
# PLATFORM_FEE_LABEL="Platform service fee"

# Paystack Payment Gateway
# Obtain from Paystack Dashboard -> Settings -> API Keys & Webhooks
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_live_your_paystack_public_key"
PAYSTACK_SECRET_KEY="sk_live_your_paystack_secret_key"
PAYSTACK_WEBHOOK_SECRET="your_paystack_webhook_secret_or_secret_key"

# AI Auto-Grading Configuration: "gemini", "openai", "groq" or "openrouter".
# AI_PROVIDER is tried first; any other provider with a key set is used if it fails.
AI_PROVIDER="gemini"
GEMINI_API_KEY="your_gemini_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here"
# GROQ_API_KEY="your_groq_api_key_here"
# OPENROUTER_API_KEY="your_openrouter_api_key_here"
# Optional model overrides. Gemini: tried first, then the app falls back through current models automatically.
# GEMINI_MODEL="gemini-3.8-flash"
# OPENAI_MODEL="gpt-4o-mini"
# GROQ_MODEL="llama-3.3-70b-versatile"
# OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct"

# University Email Notifications Configuration (SMTP)
SMTP_HOST="smtp.mailersend.net"
SMTP_PORT="587"
SMTP_USER="your_smtp_username"
SMTP_PASS="your_smtp_password"
SMTP_FROM="ACADEMIA LMS <noreply@your-domain.edu.ng>"

# Set to "true" once email reaches every student (verified sending domain): students must then confirm
# their email before they can sign in. Leave unset while only test emails can be delivered.
REQUIRE_EMAIL_VERIFICATION="false"
