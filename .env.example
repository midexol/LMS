# Database (Supabase Postgres: Project Settings -> Database -> Connection string)
# Pooled "Transaction" connection (port 6543) for the app at runtime
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432) for `npm run db:push`
DIRECT_URL="postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres"

# File Storage (Supabase Storage: Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"
# Server-only; never expose to the browser
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
# Public bucket; set its file size limit to 100 MB and restrict allowed MIME types in the dashboard
SUPABASE_STORAGE_BUCKET="course-uploads"

# Session Security (Required for cryptographic cookie signing)
# Generate a strong 32+ character random secret (e.g. `openssl rand -hex 32`)
SESSION_SECRET="your_production_hmac_session_secret_min_32_chars"

# Public support email shown on the contact dialog (optional: the card is hidden when unset)
NEXT_PUBLIC_SUPPORT_EMAIL="support@your-domain.edu.ng"

# Public Application Base URL
NEXT_PUBLIC_APP_URL="https://your-domain.edu.ng"

# Privy Authentication (Google, Email OTP, Web3 Wallets)
# Obtain free from https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID="your_privy_app_id_here"
# Server-side secret used to verify Privy access tokens (Dashboard -> App settings -> API keys)
PRIVY_APP_SECRET="your_privy_app_secret_here"

# Shared Rate Limiting (Upstash Redis REST) - required for accurate limits on serverless/multi-instance hosting
# Obtain from https://console.upstash.com -> Redis database -> REST API. Without these, limits are per-instance only.
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token"

# Paystack Payment Gateway
# Obtain from Paystack Dashboard -> Settings -> API Keys & Webhooks
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_live_your_paystack_public_key"
PAYSTACK_SECRET_KEY="sk_live_your_paystack_secret_key"
PAYSTACK_WEBHOOK_SECRET="your_paystack_webhook_secret_or_secret_key"

# AI Auto-Grading Configuration: "gemini" or "openai"
AI_PROVIDER="gemini"
GEMINI_API_KEY="your_gemini_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here"
# Optional model overrides (defaults: gemini-2.5-flash, gpt-4o-mini)
# GEMINI_MODEL="gemini-2.5-flash"
# OPENAI_MODEL="gpt-4o-mini"

# University Email Notifications Configuration (SMTP)
SMTP_HOST="smtp.mailersend.net"
SMTP_PORT="587"
SMTP_USER="your_smtp_username"
SMTP_PASS="your_smtp_password"
SMTP_FROM="ACADEMIA LMS <noreply@your-domain.edu.ng>"
